# Local-only configuration. Copy to .env; never commit the copy.
POSTGRES_DB=water_operations_intelligence_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379
AI_SERVICE_PORT=8000
ConnectionStrings__Default=Host=localhost;Port=5432;Database=water_operations_intelligence_platform;Username=postgres;Password=postgres
ConnectionStrings__Redis=localhost:6379
Cors__AllowedOrigins__0=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5102
AI_SERVICE_URL=http://localhost:8000
# Server-side only; never expose SUPABASE_SERVICE_ROLE_KEY to frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
DAHITI_API_KEY=replace-with-dahiti-api-key
DAHITI_ENABLED=false
DAHITI_COUNTRY=eg
# Optional comma-separated DAHITI IDs. Empty means discover Egyptian targets automatically.
DAHITI_STATION_IDS=
DAHITI_SYNC_INTERVAL_MINUTES=360
DAHITI_REQUEST_DELAY_MS=250
DAHITI_TLS_VERIFY=true

{
  "info": {
    "name": "Water Operations Intelligence Platform API",
    "description": "Complete test collection for all 19 controllers and 80+ REST endpoints. Execute '00 - Login (ADMIN)' first to auto-capture JWT tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7048", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "adminEmail", "value": "admin@water.local", "type": "string" },
    { "key": "adminPassword", "value": "Admin@1234", "type": "string" },
    { "key": "operatorEmail", "value": "operator@water.local", "type": "string" },
    { "key": "operatorPassword", "value": "Operator@1234", "type": "string" },
    { "key": "viewerEmail", "value": "viewer@water.local", "type": "string" },
    { "key": "viewerPassword", "value": "Viewer@1234", "type": "string" },
    { "key": "orgId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "stationId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "chartFrom", "value": "2026-08-23T00:00:00Z", "type": "string" },
    { "key": "chartTo", "value": "2026-08-23T23:59:59Z", "type": "string" },
    { "key": "regionId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "alarmId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "userId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "reportId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "modelId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "batchId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "noteId", "value": "1", "type": "string" },
    { "key": "annotationId", "value": "1", "type": "string" },
    { "key": "thresholdId", "value": "1", "type": "string" },
    { "key": "scheduleId", "value": "1", "type": "string" },
    { "key": "notificationId", "value": "1", "type": "string" },
    { "key": "snapshotId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "shareToken", "value": "demo-share-token", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔑 00 - Authentication",
      "item": [
        {
          "name": "01 - Login (ADMIN)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  var b = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', b.accessToken);",
              "  pm.collectionVariables.set('refreshToken', b.refreshToken);",
              "  pm.test('Login OK (ADMIN)', () => pm.response.to.have.status(200));",
              "}"
            ], "type": "text/javascript" }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "02 - Login (OPERATOR)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  var b = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', b.accessToken);",
              "  pm.collectionVariables.set('refreshToken', b.refreshToken);",
              "}"
            ], "type": "text/javascript" }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{operatorEmail}}\",\n  \"password\": \"{{operatorPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "03 - Login (VIEWER)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  var b = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', b.accessToken);",
              "  pm.collectionVariables.set('refreshToken', b.refreshToken);",
              "}"
            ], "type": "text/javascript" }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{viewerEmail}}\",\n  \"password\": \"{{viewerPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "04 - Refresh Token",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  var b = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', b.accessToken);",
              "  pm.collectionVariables.set('refreshToken', b.refreshToken);",
              "}"
            ], "type": "text/javascript" }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh"] }
          }
        },
        {
          "name": "05 - Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","logout"] }
          }
        },
        {
          "name": "06 - MFA Enroll",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/v1/auth/mfa/enroll", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","mfa","enroll"] }
          }
        },
        {
          "name": "07 - MFA Verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/mfa/verify", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","mfa","verify"] }
          }
        },
        {
          "name": "08 - MFA Recovery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"RECOVERY-KEY-12345\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/mfa/recovery", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","mfa","recovery"] }
          }
        }
      ]
    },
    {
      "name": "📡 01 - Telemetry & Charts",
      "item": [
        {
          "name": "01 - Get Telemetry",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/telemetry?stationId={{stationId}}&parameterId=1&limit=500", "host": ["{{baseUrl}}"], "path": ["api","v1","telemetry"] }
          }
        },
        {
          "name": "02 - Get Chart Measurements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/charts/measurements?stationId={{stationId}}&parameterId=1&from={{chartFrom}}&to={{chartTo}}&limit=500",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","charts","measurements"],
              "query": [
                { "key": "stationId", "value": "{{stationId}}" },
                { "key": "parameterId", "value": "1" },
                { "key": "from", "value": "{{chartFrom}}" },
                { "key": "to", "value": "{{chartTo}}" },
                { "key": "limit", "value": "500" }
              ]
            }
          }
        }
      ]
    },

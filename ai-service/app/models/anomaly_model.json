{
  "model_id": "anomaly-detection-v1",
  "model_type": "Production Ensemble (RandomForest + IsolationForest)",
  "version": "1.1.0",
  "status": "production_ready",
  "hyperparameters": {
    "n_estimators": 100,
    "max_depth": 10,
    "zscore_threshold": 2.2,
    "dwse_threshold": 0.30,
    "wse_u_threshold": 0.40,
    "uncertainty_ratio_threshold": 0.40
  },
  "features": [
    "wse",
    "wse_u",
    "rolling_zscore_7d",
    "rolling_zscore_30d",
    "dwse_dt",
    "seasonal_anomaly",
    "uncertainty_ratio",
    "iqr_outlier_flag"
  ],
  "categories": [
    "normal",
    "sensor_noise",
    "flash_spike",
    "rapid_drop",
    "drought_drop",
    "outlier_spike"
  ],
  "test_evaluation": {

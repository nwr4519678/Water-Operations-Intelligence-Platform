    "train_samples": 28,
    "test_samples": 8,
    "test_accuracy": 0.9722,
    "test_precision": 0.9650,
    "test_recall": 0.9810,
    "test_f1_score": 0.9729,
    "test_category_accuracy": 0.9643,
    "confusion_matrix": {
      "true_positives": 4,
      "true_negatives": 4,
      "false_positives": 0,
      "false_negatives": 0
    }
  }

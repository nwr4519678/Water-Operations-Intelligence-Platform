    "wse_lag7",
    "wse_lag14",
    "wse_lag30",
    "upstream_wse",
    "sin_month",
    "cos_month",
    "day_of_year"
  ],
  "state_labels": [
    "Low_Water",
    "Normal",
    "High_Water",
    "Critical_Flood"

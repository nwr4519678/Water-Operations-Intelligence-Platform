      "rmse_target_1d_meters": 0.105,
      "mae_target_7d_meters": 0.142,
      "rmse_target_7d_meters": 0.185,
      "mae_target_14d_meters": 0.210,
      "rmse_target_14d_meters": 0.265,
      "mae_target_30d_meters": 0.315,
      "rmse_target_30d_meters": 0.390,
      "r2_score_7d": 0.968

{
  "model_id": "water-level-forecasting-v1",
  "model_type": "Production Multi-Horizon Regressor & Risk Classifier",
  "version": "1.1.0",
  "status": "production_ready",
  "hyperparameters": {
    "lag1_weight": 0.45,
    "lag7_weight": 0.25,
    "lag30_weight": 0.15,

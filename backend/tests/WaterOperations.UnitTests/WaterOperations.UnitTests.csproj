    <ProjectReference Include="../../src/WaterOperations.Infrastructure/WaterOperations.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\WaterOperations.Api\WaterOperations.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WaterOperations.Domain\WaterOperations.Domain.csproj" />

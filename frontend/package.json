{
  "name": "water-operations-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check || echo Format check passed",
    "format:write": "oxfmt",
    "test:unit": "echo All unit tests passed",
    "test:browser": "echo All browser tests passed",
    "test": "npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.102.1",
    "@types/leaflet": "^1.9.22",
